# Copied into the Elastic Beanstalk source bundle by .github/workflows/deploy-elasticbeanstalk.yml.
# The platform's nginx forwards requests to port 5000; the app listens on PORT (see Program.cs).
# Secrets (DATABASE_URL, JWT_SECRET_KEY, API keys) are set as environment properties in the
# Elastic Beanstalk console, not here, because this file is committed.
option_settings:
  aws:elasticbeanstalk:application:environment:
    PORT: "5000"
    ASPNETCORE_ENVIRONMENT: Production
