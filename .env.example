# Either a URL (takes precedence)...
# MYSQL_URL=mysql://user:pass@host:3306/journey_planning?ssl-mode=Required
# ...or the individual settings:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=journey_planning
# MYSQL_SSL_MODE=Required
JWT_SECRET_KEY=change-me
OPENWEATHER_API_KEY=
OPENROUTER_API_KEY=
# Email (verification + password reset). Gmail needs an app password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=
# Or send through Mailgun's HTTPS API instead of SMTP (needed on Render, which blocks SMTP):
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_API_URL=https://api.eu.mailgun.net   (EU accounts only)
# RESEND_API_KEY= / RESEND_FROM=   (alternative HTTPS provider)
FRONTEND_URL=http://localhost:3000
